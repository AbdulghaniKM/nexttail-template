{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css"
  },
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "node_modules/**",
    "pnpm-lock.yaml",
    "next-env.d.ts",
    "src/config/routes.gen.ts"
  ]
}
