{
  "name": "nexttail",
  "private": true,
  "version": "0.1.0",
  "description": "A modern Next.js starter with Tailwind CSS v4, TypeScript, and an on-demand component registry.",
  "type": "module",
  "scripts": {
    "routes": "node scripts/generate-routes.mjs",
    "predev": "node scripts/generate-routes.mjs",
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/generate-routes.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "node scripts/generate-routes.mjs && tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "fix": "oxlint --fix && oxfmt",
    "add-component": "node scripts/add.mjs",
    "add-hook": "node scripts/add.mjs --hook",
    "nexttail:verify": "node scripts/add.mjs verify"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "date-fns": "^4.4.0",
    "motion": "^13.1.0",
    "next": "^16.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.517",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "~6.0.3"
  }
}
